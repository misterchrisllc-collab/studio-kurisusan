# Copy to .env.local and fill in values from your Supabase project (Settings → API).
# Also add these in Vercel → Project → Settings → Environment Variables for production.

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (SECRET — server-only, used by the contact form server action)
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin area (/admin/storyboards) ──
# Comma-separated emails allowed into /admin. The account itself is a Supabase
# Auth user (Supabase → Authentication → Users → Add user). A login that isn't
# listed here is refused even with the right password.
ADMIN_EMAILS=

# Storyboards: "Organize My Ideas" (Claude). Server-only. Optional.
ANTHROPIC_API_KEY=

# Storyboards: "Generate sketch" (OpenAI Images). Server-only. Optional.
OPENAI_API_KEY=
# STORYBOARD_IMAGE_MODEL=gpt-image-1
